[Unit]
Description=NOVA AI API Server
After=network.target

[Service]
Type=simple
User=nova_ai
WorkingDirectory=/opt/nova_ai
ExecStart=/opt/nova_ai/.venv/bin/nova serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment=HOME=/opt/nova_ai
# Binding 0.0.0.0 requires authentication. This file MUST exist and contain:
#   NOVA_AI_API_KEY=<key>      (generate one: `nova auth generate-key`)
# It is not prefixed with "-", so the unit fails to start if the file is
# missing — preventing an accidentally unauthenticated public server.
EnvironmentFile=/etc/nova_ai/env

[Install]
WantedBy=multi-user.target
